# Database Configuration (SQLite local for development / PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Authentication Secrets (Must be a secure random secret of at least 32 characters in production)
JWT_SECRET="replace-with-a-secure-random-secret-key-minimum-32-chars-long"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock Payment Gateway Config
MOCK_PAYMENT_SECRET="replace-with-a-secure-mock-payment-secret-key"
MOCK_PAYMENT_AUTO_SUCCESS="true"

# Teacher Referral Commission Configuration (Default: 20%)
DEFAULT_TEACHER_COMMISSION_RATE="0.20"
