# ==============================================================================
# espressivo ART — Environment Configuration (.env.example)
# ==============================================================================

# Database Configuration (SQLite local for development / PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Authentication Secrets (Must be a secure random secret of at least 32 characters in production)
JWT_SECRET="replace-with-a-secure-random-secret-key-minimum-32-chars-long"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock Payment Gateway Config (Disabled in production unless testing)
MOCK_PAYMENT_SECRET="replace-with-a-secure-mock-payment-secret-key-min-32-chars"
MOCK_PAYMENT_AUTO_SUCCESS="true"
ENABLE_MOCK_CHECKOUT="false"

# Teacher Referral Commission Configuration (Default: 20%)
DEFAULT_TEACHER_COMMISSION_RATE="0.20"

# ------------------------------------------------------------------------------
# Distributed Rate Limiting & Storage (Production Required)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), rate limiting enforces a fail-closed policy
# if distributed storage is missing, protecting against container brute-force bypass.
#
# Option A: Upstash Redis REST API (Recommended for Serverless / Edge)
# UPSTASH_REDIS_REST_URL="https://example.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="replace-with-your-upstash-rest-token"
#
# Option B: Standard Redis Connection URL
# REDIS_URL="redis://default:password@redis.internal:6379"
#
# Emergency Staging/Preview Override ONLY (Logs critical security warning):
# ALLOW_INSECURE_IN_MEMORY_RATE_LIMITER="false"

# ------------------------------------------------------------------------------
# Reverse Proxy & Client IP Extraction (Anti-Spoofing Architecture)
# ------------------------------------------------------------------------------
# TRUSTED_PROXY_COUNT: Number of reverse proxy hops in front of Next.js (default: 1).
# Prevents attacker-injected X-Forwarded-For headers by taking the rightmost trusted hop.
TRUSTED_PROXY_COUNT="1"

# TRUSTED_PROXY_HEADER: Optional validated edge proxy header (takes precedence over X-Forwarded-For)
# Examples:
# - "cf-connecting-ip" (Cloudflare)
# - "true-client-ip"   (Akamai / Cloudflare Enterprise)
# - "x-real-ip"        (Nginx reverse proxy with proxy_set_header X-Real-IP $remote_addr)
# TRUSTED_PROXY_HEADER="cf-connecting-ip"

# TRUSTED_PROXIES: Comma-separated list of trusted upstream proxy IPs/CIDRs
# TRUSTED_PROXIES="127.0.0.1,10.0.0.1,172.16.0.1"
